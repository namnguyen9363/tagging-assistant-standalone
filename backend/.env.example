# Databricks Model Serving — required for POST /api/rag/ask to generate answers.
# Copy this file to .env and fill in real values (never commit .env).

# Your Databricks workspace URL, no trailing slash.
# e.g. https://adb-861321016882871.11.azuredatabricks.net
DATABRICKS_WORKSPACE_URL=

# Databricks Personal Access Token (starts with "dapi"), generated from
# workspace Settings -> Developer -> Access tokens. The token's user/service
# principal must have "Can Query" permission on the
# databricks-meta-llama-3-3-70b-instruct serving endpoint.
DATABRICKS_TOKEN=

# Optional
# PORT=4000
# ALLOWED_ORIGIN=http://localhost:5173
