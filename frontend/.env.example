# Auth0 — same 3 variable names TAG WISE uses (tag-wise-fe/.env), so you can copy the
# values straight from there. Copy this file to .env.local (or .env) and fill in.
#
# NOTE: whichever Auth0 Application these values point to, its "Allowed Callback
# URLs" / "Allowed Web Origins" / "Allowed Logout URLs" (Auth0 Dashboard) must include
# this app's own URL (http://localhost:5174 for local dev, plus the Vercel prod URL)
# — TAG WISE's Auth0 Application is currently only allow-listed for TAG WISE's own
# URLs. Reusing the exact same VITE_AUTH0_CLIENT_ID as TAG WISE means adding this
# app's URLs to that same Auth0 Application's allow-list (shared login across both
# apps); using a different Application (new Client ID, same tenant) keeps them
# separate — either way this is an Auth0 Dashboard change, not something in code.

# Auth0 tenant domain, e.g. dev-w6r0e5mg0ou7yshh.us.auth0.com
VITE_AUTH0_DOMAIN_ID=

# Auth0 Application Client ID
VITE_AUTH0_CLIENT_ID=

# Must be an allow-listed callback URL on the Auth0 Application above.
# Local dev (this app's Vite port is 5174, not TAG WISE's 5173):
VITE_AUTH0_REDIRECT_URI=http://localhost:5174
